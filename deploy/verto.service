# Без Docker: скопіть проєкт у /opt/verto, `cp deploy/verto.service /etc/systemd/system/`,
# `systemctl enable --now verto`. HTTPS забезпечте через Caddy/nginx перед ним.
[Unit]
Description=VERTO Web
After=network.target

[Service]
WorkingDirectory=/opt/verto
ExecStart=/usr/bin/node src/server.js
Environment=PORT=3000 HOST=127.0.0.1 VERTO_DB=/var/lib/verto/verto.db VERTO_SECURE_COOKIES=1
User=verto
StateDirectory=verto
Restart=on-failure

[Install]
WantedBy=multi-user.target
